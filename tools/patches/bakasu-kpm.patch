+package org.bakasu.bakasu.domain.usecase
+
+import org.bakasu.bakasu.data.kpm.KpmRepository
+
+class RefreshKpmUseCase(private val repository: KpmRepository) {
+    suspend operator fun invoke() = repository.refresh()
+}
+
+class ReadKpmInfoUseCase(private val repository: KpmRepository) {
+    suspend operator fun invoke(moduleId: String) = repository.info(moduleId)
+}
+
+class LoadKpmUseCase(private val repository: KpmRepository) {
+    suspend operator fun invoke(uri: String, args: String) = repository.load(uri, args)
+}
+
+class UnloadKpmUseCase(private val repository: KpmRepository) {
+    suspend operator fun invoke(moduleId: String) = repository.unload(moduleId)
+}
+
+class ControlKpmUseCase(private val repository: KpmRepository) {
+    suspend operator fun invoke(moduleId: String, args: String) = repository.control(moduleId, args)
+}
