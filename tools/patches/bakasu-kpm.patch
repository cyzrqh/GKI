+import org.bakasu.bakasu.ui.component.SwipeableSnackbarHost
+import org.bakasu.bakasu.ui.component.rememberConfirmDialog
+import org.bakasu.bakasu.ui.component.rememberCustomDialog
+import org.bakasu.bakasu.ui.component.settings.AppBackButton
+import org.bakasu.bakasu.ui.component.settings.SegmentedColumn
+import org.bakasu.bakasu.ui.component.settings.SettingsBaseWidget
+import org.bakasu.bakasu.ui.component.settings.lazySegmentColumn
+import org.bakasu.bakasu.ui.navigation.LocalNavigator
+import org.bakasu.bakasu.ui.theme.blurSource
+import org.bakasu.bakasu.ui.util.ActivityResumeEffect
+import org.bakasu.bakasu.ui.util.LocalSnackbarHost
+import org.bakasu.bakasu.ui.util.adaptiveScaffoldWindowInsets
+import org.bakasu.bakasu.ui.util.showReplacingSnackbar
+import org.bakasu.bakasu.ui.viewmodel.KpmViewModel
+import org.koin.compose.viewmodel.koinViewModel
+
+@OptIn(ExperimentalMaterial3Api::class, ExperimentalMaterial3ExpressiveApi::class)
+@Composable
+fun KpmScreen() {
+    val viewModel = koinViewModel<KpmViewModel>()
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    val context = LocalContext.current
+    val navigator = LocalNavigator.current
+    val snackbar = LocalSnackbarHost.current
+    val scope = rememberCoroutineScope()
+    val confirmDialog = rememberConfirmDialog()
+    var importUri by remember { mutableStateOf<String?>(null) }
+    var loadArgs by remember { mutableStateOf("") }
+    var controlArgs by remember { mutableStateOf("") }
+    var pickingFile by remember { mutableStateOf(false) }
+    var confirmingUnload by remember { mutableStateOf(false) }
+
+    val importDialog = rememberCustomDialog { dismiss ->
+        AlertDialog(
+            onDismissRequest = {
+                importUri = null
+                loadArgs = ""
+                dismiss()
+            },
+            title = { Text(stringResource(R.string.kpm_load)) },
+            text = {
+                OutlinedTextField(
+                    value = loadArgs,
+                    onValueChange = { loadArgs = it },
+                    label = { Text(stringResource(R.string.kpm_args)) },
+                    supportingText = { Text(stringResource(R.string.kpm_load_args_hint)) },
+                    maxLines = 4,
+                )
+            },
+            confirmButton = {
+                TextButton(
+                    enabled = state.available && !state.busy && importUri != null,
+                    onClick = {
+                        importUri?.let { viewModel.load(it, loadArgs) }
+                        importUri = null
+                        loadArgs = ""
+                        dismiss()
+                    },
+                ) { Text(stringResource(R.string.kpm_load)) }
+            },
+            dismissButton = {
+                TextButton(onClick = {
+                    importUri = null
+                    loadArgs = ""
+                    dismiss()
+                }) { Text(stringResource(R.string.cancel)) }
+            },
+        )
+    }
+
+    val detailDialog = rememberCustomDialog { dismiss ->
+        state.selectedModule?.let { module ->
+            AlertDialog(
+                onDismissRequest = {
+                    viewModel.dismissDetails()
+                    controlArgs = ""
+                    dismiss()
+                },
+                title = { Text(module.name) },
+                text = {
+                    Column(Modifier.heightIn(max = 360.dp).verticalScroll(rememberScrollState())) {
+                        Text(module.rawInfo.ifBlank { module.id }, style = MaterialTheme.typography.bodySmall)
+                        OutlinedTextField(
+                            modifier = Modifier.padding(top = 12.dp),
+                            value = controlArgs,
+                            onValueChange = { controlArgs = it },
+                            enabled = !state.busy,
+                            label = { Text(stringResource(R.string.kpm_args)) },
+                            supportingText = { Text(stringResource(R.string.kpm_control_args_hint)) },
+                            maxLines = 4,
+                        )
+                        TextButton(
+                            enabled = state.available && !state.busy && controlArgs.isNotEmpty(),
+                            onClick = { viewModel.control(module.id, controlArgs) },
+                        ) { Text(stringResource(R.string.kpm_control)) }
+                        TextButton(
+                            enabled = state.available && !state.busy && !confirmingUnload,
+                            onClick = {
+                                confirmingUnload = true
+                                scope.launch {
+                                    try {
+                                        val answer = confirmDialog.awaitConfirm(
+                                            title = context.getString(R.string.kpm_unload),
+                                            content = context.getString(R.string.kpm_unload_confirm, module.name),
+                                            confirm = context.getString(R.string.kpm_unload),
+                                            dismiss = context.getString(R.string.cancel),
+                                        )
+                                        if (answer == ConfirmResult.Confirmed) viewModel.unload(module.id)
+                                    } finally {
+                                        confirmingUnload = false
+                                    }
+                                }
+                            },
+                        ) { Text(stringResource(R.string.kpm_unload)) }
+                    }
+                },
+                confirmButton = {
+                    TextButton(onClick = {
+                        viewModel.dismissDetails()
+                        controlArgs = ""
+                        dismiss()
+                    }) { Text(stringResource(R.string.close)) }
+                },
+            )
+        }
+    }
+
+    val picker = rememberLauncherForActivityResult(ActivityResultContracts.GetContent()) { uri ->
+        pickingFile = false
+        if (uri != null && state.available && !state.busy) {
+            importUri = uri.toString()
+            loadArgs = ""
+            importDialog.show()
+        }
+    }
+
+    ActivityResumeEffect { viewModel.refresh() }
+    LaunchedEffect(viewModel) {
+        viewModel.events.collect { message -> snackbar.showReplacingSnackbar(message) }
+    }
+    LaunchedEffect(state.selectedModule) {
+        if (state.selectedModule == null) detailDialog.hide()
+    }
+
+    Scaffold(
+        contentWindowInsets = adaptiveScaffoldWindowInsets(),
+        containerColor = Color.Transparent,
+        topBar = {
+            LargeFlexibleTopAppBar(
+                title = { Text(stringResource(R.string.kpm_title)) },
+                navigationIcon = { AppBackButton(onClick = { navigator.pop() }) },
+                actions = {
+                    IconButton(enabled = !state.busy, onClick = viewModel::refresh) {
+                        Icon(Icons.TwoTone.Refresh, contentDescription = stringResource(R.string.kpm_refresh))
+                    }
+                },
+            )
+        },
+        snackbarHost = { SwipeableSnackbarHost(hostState = snackbar) },
+        floatingActionButton = {
+            if (state.available) {
+                FloatingActionButton(onClick = {
+                    if (!state.busy && !pickingFile) {
+                        pickingFile = true
+                        picker.launch("*/*")
+                    }
+                }) {
+                    Icon(Icons.TwoTone.Add, contentDescription = stringResource(R.string.kpm_load))
+                }
+            }
+        },
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier.fillMaxSize().blurSource(),
+            contentPadding = PaddingValues(
+                top = padding.calculateTopPadding() + 8.dp,
+                bottom = padding.calculateBottomPadding() + 88.dp,
+            ),
+        ) {
+            item {
+                SegmentedColumn(content = {
+                    item {
+                        SettingsBaseWidget(
+                            title = if (state.available) {
+                                stringResource(R.string.kpm_version, state.version)
+                            } else {
+                                stringResource(R.string.kpm_title)
+                            },
+                            description = state.error ?: if (state.available) {
+                                stringResource(R.string.kpm_manual_only)
+                            } else if (!state.loaded) {
+                                stringResource(R.string.kpm_checking)
+                            } else {
+                                stringResource(R.string.kpm_unsupported)
+                            },
+                            isError = state.error != null,
+                        )
+                    }
+                })
+                if (state.busy) LinearProgressIndicator(Modifier.fillMaxWidth().padding(horizontal = 16.dp))
+            }
+            if (state.available && state.modules.isEmpty()) {
+                item {
+                    SegmentedColumn(content = {
+                        item {
+                            SettingsBaseWidget(title = stringResource(R.string.kpm_empty), description = null)
+                        }
+                    })
+                }
+            }
+            lazySegmentColumn(items = state.modules, key = { _, module -> module.id }) { _, module ->
+                SettingsBaseWidget(
+                    title = module.name,
+                    description = module.description.ifBlank { module.id },
+                    enabled = state.available && !state.busy,
+                    onClick = {
+                        controlArgs = ""
+                        viewModel.inspect(module)
+                        detailDialog.show()
+                    },
+                )
+            }
+        }
+    }
+}
