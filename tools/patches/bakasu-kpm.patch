diff --git a/manager/app/src/main/java/org/bakasu/bakasu/ui/viewmodel/KpmViewModel.kt b/manager/app/src/main/java/org/bakasu/bakasu/ui/viewmodel/KpmViewModel.kt
new file mode 100644
index 0000000..b28c2cf
--- /dev/null
+++ b/manager/app/src/main/java/org/bakasu/bakasu/ui/viewmodel/KpmViewModel.kt
@@ -0,0 +1,156 @@
+package org.bakasu.bakasu.ui.viewmodel
+
+import android.content.Context
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asSharedFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import org.bakasu.bakasu.R
+import org.bakasu.bakasu.domain.model.KpmAuthorizationException
+import org.bakasu.bakasu.domain.model.KpmCommandException
+import org.bakasu.bakasu.domain.model.KpmImportLimitException
+import org.bakasu.bakasu.domain.model.KpmInputException
+import org.bakasu.bakasu.domain.model.KpmInvalidModuleException
+import org.bakasu.bakasu.domain.model.KpmModule
+import org.bakasu.bakasu.domain.model.KpmProbeException
+import org.bakasu.bakasu.domain.model.KpmProtocolException
+import org.bakasu.bakasu.domain.model.KpmUnsupportedException
+import org.bakasu.bakasu.domain.usecase.ControlKpmUseCase
+import org.bakasu.bakasu.domain.usecase.LoadKpmUseCase
+import org.bakasu.bakasu.domain.usecase.ReadKpmInfoUseCase
+import org.bakasu.bakasu.domain.usecase.RefreshKpmUseCase
+import org.bakasu.bakasu.domain.usecase.UnloadKpmUseCase
+
+data class KpmUiState(
+    val loaded: Boolean = false,
+    val busy: Boolean = false,
+    val available: Boolean = false,
+    val version: String = "",
+    val modules: List<KpmModule> = emptyList(),
+    val selectedModule: KpmModule? = null,
+    val error: String? = null,
+)
+
+class KpmViewModel(
+    private val context: Context,
+    private val refreshKpm: RefreshKpmUseCase,
+    private val readInfo: ReadKpmInfoUseCase,
+    private val loadKpm: LoadKpmUseCase,
+    private val unloadKpm: UnloadKpmUseCase,
+    private val controlKpm: ControlKpmUseCase,
+) : ViewModel() {
+    private val mutableState = MutableStateFlow(KpmUiState())
+    val state = mutableState.asStateFlow()
+    private val mutableEvents = MutableSharedFlow<String>(extraBufferCapacity = 1)
+    val events = mutableEvents.asSharedFlow()
+
+    fun refresh() = operation { reload() }
+
+    fun load(uri: String, args: String) = operation {
+        loadKpm(uri, args).onSuccess {
+            mutableEvents.emit(context.getString(R.string.kpm_loaded))
+            reload()
+        }.onFailure { failed(it) }
+    }
+
+    fun inspect(module: KpmModule) {
+        if (mutableState.value.busy) return
+        mutableState.update { it.copy(selectedModule = module) }
+        operation {
+            readInfo(module.id).onSuccess { updated ->
+                mutableState.update { it.copy(selectedModule = updated) }
+            }.onFailure { failed(it) }
+        }
+    }
+
+    fun unload(moduleId: String) = operation {
+        unloadKpm(moduleId).onSuccess {
+            mutableState.update { it.copy(selectedModule = null) }
+            mutableEvents.emit(context.getString(R.string.kpm_unloaded))
+            reload()
+        }.onFailure { failed(it) }
+    }
+
+    fun control(moduleId: String, args: String) = operation {
+        controlKpm(moduleId, args).onSuccess { value ->
+            mutableEvents.emit(context.getString(R.string.kpm_control_result, value))
+            reload()
+        }.onFailure { failed(it) }
+    }
+
+    fun dismissDetails() {
+        mutableState.update { it.copy(selectedModule = null) }
+    }
+
+    private fun operation(block: suspend () -> Unit) {
+        // Reserve before launch so repeated taps cannot start concurrent work.
+        if (mutableState.value.busy) return
+        mutableState.update { it.copy(busy = true, error = null) }
+        viewModelScope.launch {
+            try {
+                block()
+            } catch (error: CancellationException) {
+                throw error
+            } catch (error: Exception) {
+                failed(error)
+            } finally {
+                mutableState.update { it.copy(busy = false) }
+            }
+        }
+    }
+
+    private suspend fun reload() {
+        refreshKpm().onSuccess { snapshot ->
+            mutableState.update { current ->
+                current.copy(
+                    loaded = true,
+                    available = true,
+                    version = snapshot.version,
+                    modules = snapshot.modules,
+                    selectedModule = current.selectedModule?.let { selected -> snapshot.modules.find { it.id == selected.id } },
+                    error = null,
+                )
+            }
+        }.onFailure {
+            mutableState.update { current -> current.copy(loaded = true, available = false, modules = emptyList()) }
+            failed(it)
+        }
+    }
+
+    private suspend fun failed(error: Throwable) {
+        if (error is CancellationException) throw error
+        val actual = if (error is KpmProbeException) error.cause ?: error else error
+        val message = when (actual) {
+            is KpmAuthorizationException -> context.getString(R.string.kpm_authorization_required)
+
+            is KpmUnsupportedException -> context.getString(R.string.kpm_unsupported)
+
+            is KpmProtocolException -> context.getString(R.string.kpm_protocol_error)
+
+            is KpmInputException -> context.getString(R.string.kpm_invalid_input)
+
+            is KpmInvalidModuleException -> context.getString(R.string.kpm_invalid_module)
+
+            is KpmImportLimitException -> context.getString(R.string.kpm_import_limit)
+
+            is KpmCommandException -> actual.diagnostics.takeIf(String::isNotBlank)?.let {
+                context.getString(R.string.kpm_command_failed_detail, it)
+            } ?: context.getString(R.string.kpm_command_failed)
+
+            else -> context.getString(R.string.kpm_command_failed)
+        }
+        mutableState.update {
+            it.copy(
+                error = message,
+                available = it.available && actual !is KpmAuthorizationException && actual !is KpmUnsupportedException &&
+                    actual !is KpmProtocolException && error !is KpmProbeException,
+            )
+        }
+        mutableEvents.emit(message)
+    }
+}
