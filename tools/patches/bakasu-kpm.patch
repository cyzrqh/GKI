diff --git a/manager/app/src/main/java/org/bakasu/bakasu/data/kpm/KpmProtocol.kt b/manager/app/src/main/java/org/bakasu/bakasu/data/kpm/KpmProtocol.kt
new file mode 100644
index 0000000..932a267
--- /dev/null
+++ b/manager/app/src/main/java/org/bakasu/bakasu/data/kpm/KpmProtocol.kt
@@ -0,0 +1,50 @@
+package org.bakasu.bakasu.data.kpm
+
+import java.io.DataInputStream
+import java.io.File
+import java.io.IOException
+import org.bakasu.bakasu.domain.model.KpmInputException
+import org.bakasu.bakasu.domain.model.KpmInvalidModuleException
+
+internal object KpmProtocol {
+    const val MAX_ARGUMENT_BYTES = 1023
+    private const val MAX_NAME_BYTES = 31
+
+    fun validateElf(file: File) {
+        val header = ByteArray(20)
+        try {
+            DataInputStream(file.inputStream()).use { it.readFully(header) }
+        } catch (error: IOException) {
+            throw KpmInvalidModuleException()
+        }
+        if (!header.copyOfRange(0, 4).contentEquals(byteArrayOf(0x7f, 0x45, 0x4c, 0x46)) ||
+            header[4].toInt() != 2 || header[5].toInt() != 1 || header[6].toInt() != 1 ||
+            header[16].toInt() != 1 || header[17].toInt() != 0 ||
+            header[18].toUByte().toInt() != 183 || header[19].toInt() != 0
+        ) {
+            throw KpmInvalidModuleException()
+        }
+    }
+
+    fun shellQuote(value: String): String {
+        if ('\u0000' in value) throw KpmInputException()
+        return "'${value.replace("'", "'\"'\"'")}'"
+    }
+
+    fun validateName(value: String) {
+        if (value.toByteArray(Charsets.UTF_8).size !in 1..MAX_NAME_BYTES ||
+            value == "." || value == ".." ||
+            value.any { it == '/' || it == '\\' || it.isISOControl() }
+        ) {
+            throw KpmInputException()
+        }
+    }
+
+    fun validateArgs(value: String, allowEmpty: Boolean) {
+        if ('\u0000' in value || value.toByteArray(Charsets.UTF_8).size > MAX_ARGUMENT_BYTES ||
+            !allowEmpty && value.isEmpty()
+        ) {
+            throw KpmInputException()
+        }
+    }
+}
diff --git a/manager/app/src/main/java/org/bakasu/bakasu/data/kpm/KpmRepository.kt b/manager/app/src/main/java/org/bakasu/bakasu/data/kpm/KpmRepository.kt
new file mode 100644
index 0000000..4d224b0
--- /dev/null
+++ b/manager/app/src/main/java/org/bakasu/bakasu/data/kpm/KpmRepository.kt
@@ -0,0 +1,191 @@
+package org.bakasu.bakasu.data.kpm
+
+import android.app.Application
+import android.net.Uri
+import java.io.File
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import org.bakasu.bakasu.Natives
+import org.bakasu.bakasu.data.kpm.KpmProtocol.MAX_ARGUMENT_BYTES
+import org.bakasu.bakasu.data.kpm.KpmProtocol.shellQuote
+import org.bakasu.bakasu.data.kpm.KpmProtocol.validateArgs
+import org.bakasu.bakasu.data.kpm.KpmProtocol.validateElf
+import org.bakasu.bakasu.data.kpm.KpmProtocol.validateName
+import org.bakasu.bakasu.data.shell.KsuCliRepository
+import org.bakasu.bakasu.domain.model.KpmAuthorizationException
+import org.bakasu.bakasu.domain.model.KpmCommandException
+import org.bakasu.bakasu.domain.model.KpmImportLimitException
+import org.bakasu.bakasu.domain.model.KpmInputException
+import org.bakasu.bakasu.domain.model.KpmInvalidModuleException
+import org.bakasu.bakasu.domain.model.KpmModule
+import org.bakasu.bakasu.domain.model.KpmProbeException
+import org.bakasu.bakasu.domain.model.KpmProtocolException
+import org.bakasu.bakasu.domain.model.KpmSnapshot
+import org.bakasu.bakasu.domain.model.KpmUnsupportedException
+import org.json.JSONArray
+import org.json.JSONException
+import org.json.JSONObject
+
+class KpmRepository(
+    private val application: Application,
+    private val ksuCliRepository: KsuCliRepository,
+) {
+    private val operations = Mutex()
+
+    suspend fun refresh(): Result<KpmSnapshot> = operation {
+        val version = requireReady()
+        val names = parse { JSONArray(command("list", "--json")) }
+        val ids = (0 until names.length()).map { index ->
+            parse { names.getString(index) }.also(::validateName)
+        }.distinct().sorted()
+        KpmSnapshot(version, ids.map(::readInfo))
+    }
+
+    suspend fun info(moduleId: String): Result<KpmModule> = operation {
+        requireReady()
+        validateName(moduleId)
+        readInfo(moduleId)
+    }
+
+    suspend fun load(uri: String, args: String): Result<Unit> = operation {
+        requireReady()
+        validateArgs(args, allowEmpty = true)
+        val staged = File.createTempFile("kpm-", ".kpm", application.cacheDir)
+        try {
+            val input = application.contentResolver.openInputStream(Uri.parse(uri))
+                ?: throw KpmInvalidModuleException()
+            input.use { source ->
+                staged.outputStream().use { target ->
+                    val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+                    var total = 0L
+                    while (true) {
+                        currentCoroutineContext().ensureActive()
+                        val count = source.read(buffer)
+                        if (count < 0) break
+                        total += count
+                        if (total > MAX_IMPORT_BYTES) throw KpmImportLimitException()
+                        target.write(buffer, 0, count)
+                    }
+                }
+            }
+            validateElf(staged)
+            if (staged.absolutePath.toByteArray(Charsets.UTF_8).size > MAX_ARGUMENT_BYTES) {
+                throw KpmInputException()
+            }
+            requireAuthorization()
+            if (args.isEmpty()) {
+                command("load", "--", staged.absolutePath)
+            } else {
+                command("load", "--", staged.absolutePath, args)
+            }
+        } finally {
+            // libsu exec is blocking; this runs only after the loader has
+            // finished reading, including when the calling coroutine cancels.
+            staged.delete()
+        }
+        Unit
+    }
+
+    suspend fun unload(moduleId: String): Result<Unit> = operation {
+        requireReady()
+        validateName(moduleId)
+        command("unload", "--", moduleId)
+        Unit
+    }
+
+    suspend fun control(moduleId: String, args: String): Result<Int> = operation {
+        requireReady()
+        validateName(moduleId)
+        validateArgs(args, allowEmpty = false)
+        val output = command("control", "--", moduleId, args).trim()
+        val result = output.toIntOrNull() ?: throw KpmProtocolException()
+        if (result < 0) throw KpmCommandException(output)
+        result
+    }
+
+    private suspend fun <T> operation(block: suspend () -> T): Result<T> = operations.withLock {
+        withContext(Dispatchers.IO) {
+            try {
+                Result.success(block())
+            } catch (error: CancellationException) {
+                throw error
+            } catch (error: Exception) {
+                Result.failure(error)
+            }
+        }
+    }
+
+    private fun requireAuthorization() {
+        val authorized = runCatching {
+            Natives.isManager && Natives.isFullFeatured() && ksuCliRepository.rootAvailable()
+        }.getOrDefault(false)
+        if (!authorized) throw KpmAuthorizationException()
+    }
+
+    private fun requireReady(): String {
+        requireAuthorization()
+        return try {
+            val supported = parse { JSONObject(command("supported", "--json")) }
+            if (parse { supported.getInt("abi") } != KPM_ABI) throw KpmProtocolException()
+            if (!parse { supported.getBoolean("supported") }) throw KpmUnsupportedException()
+            val version = parse { JSONObject(command("version", "--json")) }
+            if (parse { version.getInt("abi") } != KPM_ABI) throw KpmProtocolException()
+            parse { version.getString("version") }.trim().takeIf(String::isNotEmpty)
+                ?: throw KpmProtocolException()
+        } catch (error: CancellationException) {
+            throw error
+        } catch (error: KpmUnsupportedException) {
+            throw error
+        } catch (error: KpmProtocolException) {
+            throw error
+        } catch (error: Exception) {
+            throw KpmProbeException(error)
+        }
+    }
+
+    private fun readInfo(moduleId: String): KpmModule {
+        val json = parse { JSONObject(command("info", "--json", "--", moduleId)) }
+        if (parse { json.getString("name") } != moduleId) throw KpmProtocolException()
+        val fields = parse { json.getJSONObject("fields") }
+        return KpmModule(
+            id = moduleId,
+            name = fields.optString("name").ifBlank { moduleId },
+            version = fields.optString("version"),
+            author = fields.optString("author"),
+            description = fields.optString("description"),
+            rawInfo = parse { json.getString("raw") },
+        )
+    }
+
+    private fun command(vararg arguments: String): String {
+        val command = (listOf(ksuCliRepository.getKsuDaemonPath(), "kpm") + arguments)
+            .joinToString(" ", transform = ::shellQuote)
+        val result = ksuCliRepository.getRootShell().newJob()
+            .add(command)
+            .to(ArrayList<String>(), ArrayList<String>())
+            .exec()
+        if (!result.isSuccess) {
+            throw KpmCommandException(result.err.joinToString("\n").take(MAX_DIAGNOSTICS))
+        }
+        return result.out.joinToString("\n")
+    }
+
+    private fun <T> parse(block: () -> T): T = try {
+        block()
+    } catch (error: JSONException) {
+        throw KpmProtocolException()
+    }
+
+    companion object {
+        private const val KPM_ABI = 2
+
+        // Application staging budget, not a claim about the kernel ABI limit.
+        private const val MAX_IMPORT_BYTES = 32L * 1024 * 1024
+        private const val MAX_DIAGNOSTICS = 4096
+    }
+}
