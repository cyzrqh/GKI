new file mode 100644
index 0000000..68a6c78
--- /dev/null
+++ b/uapi/kpm.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __KSU_UAPI_KPM_H
+#define __KSU_UAPI_KPM_H
+
+#include <linux/types.h>
+
+/* GKI_BAKASU_KPM_PORT_V1: independent additive KPM API.
+ * Do not reuse the removed packed 25-byte ioctl 200 or feature 3 (adb_root).
+ * Operations retain the official KernelPatch bridge's public numbering.
+ */
+static const __u32 SUKISU_KPM_LOAD = 1;
+static const __u32 SUKISU_KPM_UNLOAD = 2;
+static const __u32 SUKISU_KPM_NUM = 3;
+static const __u32 SUKISU_KPM_LIST = 4;
+static const __u32 SUKISU_KPM_INFO = 5;
+static const __u32 SUKISU_KPM_CONTROL = 6;
+static const __u32 SUKISU_KPM_VERSION = 7;
+static const __u32 SUKISU_KPM_LOAD_EVENT = 8;
+
+/* 32 bytes on every userspace ABI. result_code points to a signed 32-bit
+ * operation result; ioctl's own result reports only transport errors.
+ */
+struct ksu_kpm_cmd {
+    __aligned_u64 control_code;
+    __aligned_u64 arg1;
+    __aligned_u64 arg2;
+    __aligned_u64 result_code;
+};
+
+struct ksu_kpm_load_event_cmd {
+    __aligned_u64 args;
+    __aligned_u64 event;
+};
+#endif
