+#[cfg(test)]
+mod tests {
+    use super::*;
+    use clap::Parser;
+
+    #[derive(Parser)]
+    struct TestCli {
+        #[command(flatten)]
+        kpm: KpmArgs,
+    }
+
+    #[test]
+    fn ioctl_layout_and_pointed_operation_result_are_not_legacy_packed() {
+        assert_eq!(std::mem::size_of::<uapi::ksu_kpm_cmd>(), 32);
+        assert_eq!(std::mem::offset_of!(uapi::ksu_kpm_cmd, result_code), 24);
+        assert_eq!(uapi::KSU_IOCTL_KPM_RUST, 0xc0204bc9);
+        let result = invoke_with(uapi::SUKISU_KPM_NUM, 0, 0, |command| {
+            assert_eq!(command.control_code, 3);
+            unsafe { *(command.result_code as *mut i32) = 0; }
+            Ok(0)
+        }).unwrap();
+        assert_eq!(result, 0);
+    }
+
+    #[test]
+    fn transport_failure_and_negative_operation_results_are_errors() {
+        assert!(invoke_with(7, 0, 0, |_| Err(io::Error::from_raw_os_error(libc::EPERM).into())).is_err());
+        for code in [-libc::EOPNOTSUPP, -libc::ENOBUFS, i32::MIN] {
+            let result = invoke_with(7, 0, 0, |command| {
+                unsafe { *(command.result_code as *mut i32) = code; }
+                Ok(0)
+            });
+            assert!(result.is_err());
+        }
+        // A false transport success that never writes the operation result is
+        // rejected instead of inventing a successful zero value.
+        assert!(invoke_with(7, 0, 0, |_| Ok(0)).is_err());
+    }
+
+    #[test]
+    fn buffer_decoding_is_bounded_and_requires_a_real_terminator() {
+        assert_eq!(text_buffer(b"module\0ignored").unwrap(), "module");
+        assert_eq!(text_buffer(b"\0").unwrap(), "");
+        assert!(text_buffer(b"unterminated").is_err());
+        assert!(text_buffer(b"\xff\0").is_err());
+        let mut boundary = vec![b'a'; TEXT_CAPACITY];
+        boundary[TEXT_CAPACITY - 1] = 0;
+        assert_eq!(text_buffer(&boundary).unwrap().len(), TEXT_CAPACITY - 1);
+        assert!(check_result("list", -libc::ENOBUFS).is_err());
+    }
+
+    #[test]
+    fn actual_text_transport_preserves_empty_list_and_propagates_enobufs() {
+        let empty = read_text_with(uapi::SUKISU_KPM_LIST, TEXT_CAPACITY, |command| {
+            assert_eq!(command.arg2, 4096);
+            unsafe { *(command.result_code as *mut i32) = 0; }
+            Ok(0)
+        }).unwrap();
+        assert_eq!(empty, "");
+        let overflow = read_text_with(uapi::SUKISU_KPM_LIST, TEXT_CAPACITY, |command| {
+            unsafe { *(command.result_code as *mut i32) = -libc::ENOBUFS; }
+            Ok(0)
+        }).unwrap_err();
+        assert_eq!(overflow.downcast_ref::<io::Error>().unwrap().raw_os_error(), Some(libc::ENOBUFS));
+        assert!(read_text_with(7, TEXT_CAPACITY + 1, |_| panic!("must not invoke transport")).is_err());
+        assert!(read_text_with(7, 0, |_| panic!("must not invoke transport")).is_err());
+    }
+
+    #[test]
+    fn unsupported_is_distinct_from_privilege_or_transport_failure() {
+        assert!(supported_with(|| Ok("0.14.0".into())).unwrap());
+        for errno in [libc::EOPNOTSUPP, libc::ENOTTY, libc::ENOSYS] {
+            assert!(!supported_with(|| Err(io::Error::from_raw_os_error(errno).into())).unwrap());
+        }
+        assert!(supported_with(|| Ok(String::new())).is_err());
+        assert!(supported_with(|| Err(io::Error::from_raw_os_error(libc::EPERM).into())).is_err());
+        assert!(supported_with(|| Err(anyhow::anyhow!("driver unavailable"))).is_err());
+    }
+
+    #[test]
+    fn empty_list_is_valid_and_module_output_is_only_data() {
+        assert!(module_names("").unwrap().is_empty());
+        assert_eq!(module_names("first\nsecond\n").unwrap(), ["first", "second"]);
+        assert!(module_names("same\nsame\n").is_err());
+        assert!(module_names("../outside\n").is_err());
+        let fields = info_fields("name=test\nargs=$(never_execute)\n#comment=x\n");
+        assert_eq!(fields["args"], "$(never_execute)");
+        assert!(!fields.contains_key("#comment"));
+    }
+
+    #[test]
+    fn string_sizes_count_utf8_bytes_and_reject_nul() {
+        assert!(module_name(&"a".repeat(31)).is_ok());
+        assert!(module_name(&"a".repeat(32)).is_err());
+        assert!(module_name(&"中".repeat(11)).is_err());
+        assert!(bounded_cstring(b"a\0b", ARG_CAPACITY, "args", true).is_err());
+        assert!(bounded_cstring(b"", ARG_CAPACITY, "load args", true).is_ok());
+        assert!(bounded_cstring(b"", ARG_CAPACITY, "control args", false).is_err());
+        assert!(bounded_cstring(&vec![b'a'; 1023], ARG_CAPACITY, "args", false).is_ok());
+        assert!(bounded_cstring(&vec![b'a'; 1024], ARG_CAPACITY, "args", false).is_err());
+    }
+
+    #[test]
+    fn clap_preserves_arguments_as_one_value_and_supports_option_termination() {
+        let parsed = TestCli::try_parse_from(["kpm", "load", "--", "/tmp/a file.kpm", "arg;$(literal)"]).unwrap();
+        match parsed.kpm.command {
+            KpmCommand::Load { path, args } => {
+                assert_eq!(path, std::path::PathBuf::from("/tmp/a file.kpm"));
+                assert_eq!(args.as_deref(), Some("arg;$(literal)"));
+            }
+            _ => panic!("wrong command"),
+        }
+        assert!(TestCli::try_parse_from(["kpm", "list", "--json"]).is_ok());
+        assert!(TestCli::try_parse_from(["kpm", "info", "name", "--json"]).is_ok());
+        assert!(TestCli::try_parse_from(["kpm", "info", "--json", "--", "--literal-name"]).is_ok());
+        assert!(TestCli::try_parse_from(["kpm", "control", "--", "--literal-name", "-literal-args"]).is_ok());
+        assert!(TestCli::try_parse_from(["kpm", "control", "name", ""]).is_ok());
+        assert!(TestCli::try_parse_from(["kpm", "unknown"]).is_err());
+    }
+}
