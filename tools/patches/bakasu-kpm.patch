+package org.bakasu.bakasu.domain.model
+
+import java.io.IOException
+
+data class KpmModule(
+    val id: String,
+    val name: String,
+    val version: String,
+    val author: String,
+    val description: String,
+    val rawInfo: String,
+)
+
+data class KpmSnapshot(
+    val version: String,
+    val modules: List<KpmModule>,
+)
+
+class KpmAuthorizationException : IOException()
+class KpmUnsupportedException : IOException()
+class KpmProtocolException : IOException()
+class KpmInputException : IOException()
+class KpmInvalidModuleException : IOException()
+class KpmImportLimitException : IOException()
+class KpmCommandException(val diagnostics: String) : IOException()
+class KpmProbeException(cause: Throwable) : IOException(cause)
