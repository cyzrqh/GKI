diff --git a/userspace/ksud/src/android/kpm.rs b/userspace/ksud/src/android/kpm.rs
new file mode 100644
index 0000000..8f006a0
--- /dev/null
+++ b/userspace/ksud/src/android/kpm.rs
@@ -0,0 +1,383 @@
+/*
+ * Manual KPM management, adapted from the official SukiSU 96ceb4a4 userspace
+ * implementation to BakaSU's additive, manager/root-authorized ioctl 201.
+ * No automatic loading, shell execution or persistent feature writes.
+ */
+use std::{collections::BTreeMap, ffi::CString, io, path::Path};
+
+use anyhow::{Context, Result, bail};
+use clap::{Args, Subcommand};
+
+use super::{ksucalls, uapi};
+
+const BRIDGE_ABI: u32 = 2;
+const TEXT_CAPACITY: usize = 4096;
+const INFO_CAPACITY: usize = 256;
+const NAME_CAPACITY: usize = 32;
+const ARG_CAPACITY: usize = 1024;
+const PATH_CAPACITY: usize = 1024;
+
+#[derive(Args, Debug)]
+pub struct KpmArgs {
+    #[command(subcommand)]
+    command: KpmCommand,
+}
+
+#[derive(Subcommand, Debug)]
+enum KpmCommand {
+    /// Probe the actual ABI-2 loader; unsupported kernels report false
+    Supported {
+        #[arg(long)]
+        json: bool,
+    },
+    /// Print the actual running KPM loader version
+    Version {
+        #[arg(long)]
+        json: bool,
+    },
+    /// Number of currently loaded KPM modules (zero is normal)
+    Num {
+        #[arg(long)]
+        json: bool,
+    },
+    /// List the names of currently loaded KPM modules
+    List {
+        #[arg(long)]
+        json: bool,
+    },
+    /// Read module metadata without interpreting it as executable code
+    Info {
+        name: String,
+        #[arg(long)]
+        json: bool,
+    },
+    /// Manually load one module: load <path> [args]
+    Load {
+        path: std::path::PathBuf,
+        args: Option<String>,
+    },
+    /// Unload a currently loaded module
+    Unload { name: String },
+    /// Send one uninterpreted argument string to a module
+    Control { name: String, args: String },
+}
+
+fn check_result(operation: &str, result: i32) -> Result<i32> {
+    if result < 0 {
+        let errno = result.checked_neg().filter(|value| *value <= 4095);
+        if let Some(errno) = errno {
+            return Err(io::Error::from_raw_os_error(errno))
+                .with_context(|| format!("KPM {operation} failed"));
+        }
+        bail!("KPM {operation} returned an invalid negative result");
+    }
+    Ok(result)
+}
+
+fn invoke_with<F>(operation: u32, arg1: u64, arg2: u64, transport: F) -> Result<i32>
+where
+    F: FnOnce(&mut uapi::ksu_kpm_cmd) -> Result<i32>,
+{
+    let mut result = -1i32;
+    let mut command = uapi::ksu_kpm_cmd {
+        control_code: u64::from(operation),
+        arg1,
+        arg2,
+        result_code: std::ptr::from_mut(&mut result) as u64,
+    };
+    check_result("ioctl transport", transport(&mut command)?)?;
+    check_result(&format!("operation {operation}"), result)
+}
+
+fn invoke(operation: u32, arg1: u64, arg2: u64) -> Result<i32> {
+    invoke_with(operation, arg1, arg2, ksucalls::kpm_io)
+}
+
+fn text_buffer(buffer: &[u8]) -> Result<String> {
+    let end = buffer.iter().position(|byte| *byte == 0)
+        .context("KPM output is not NUL-terminated within the requested buffer")?;
+    Ok(std::str::from_utf8(&buffer[..end])
+        .context("KPM output is not valid UTF-8")?.to_owned())
+}
+
+fn read_text_with<F>(operation: u32, capacity: usize, transport: F) -> Result<String>
+where
+    F: FnOnce(&mut uapi::ksu_kpm_cmd) -> Result<i32>,
+{
+    if capacity == 0 || capacity > TEXT_CAPACITY {
+        bail!("Invalid bounded KPM text capacity");
+    }
+    let mut buffer = vec![0u8; capacity];
+    invoke_with(operation, buffer.as_mut_ptr() as u64, capacity as u64, transport)?;
+    text_buffer(&buffer)
+}
+
+fn read_text(operation: u32, capacity: usize) -> Result<String> {
+    read_text_with(operation, capacity, ksucalls::kpm_io)
+}
+
+fn bounded_cstring(value: &[u8], capacity: usize, label: &str, optional: bool) -> Result<CString> {
+    if (!optional && value.is_empty()) || value.len() >= capacity {
+        bail!("KPM {label} must contain {}..{} bytes", if optional { 0 } else { 1 }, capacity - 1);
+    }
+    CString::new(value).with_context(|| format!("KPM {label} contains an embedded NUL byte"))
+}
+
+fn module_name(value: &str) -> Result<CString> {
+    if value == "." || value == ".." || value.contains(['/', '\\'])
+        || value.chars().any(char::is_control)
+    {
+        bail!("Invalid KPM module name");
+    }
+    bounded_cstring(value.as_bytes(), NAME_CAPACITY, "module name", false)
+}
+
+fn version() -> Result<String> {
+    let value = read_text(uapi::SUKISU_KPM_VERSION, TEXT_CAPACITY)?;
+    let value = value.trim();
+    if value.is_empty() {
+        bail!("KPM version response is empty");
+    }
+    Ok(value.to_owned())
+}
+
+fn supported_with<F>(probe_version: F) -> Result<bool>
+where
+    F: FnOnce() -> Result<String>,
+{
+    match probe_version() {
+        Ok(value) if !value.trim().is_empty() => Ok(true),
+        Ok(_) => bail!("KPM version response is empty"),
+        Err(error) => {
+            let errno = error.downcast_ref::<io::Error>().and_then(io::Error::raw_os_error);
+            match errno {
+                Some(libc::EOPNOTSUPP | libc::ENOSYS | libc::ENOTTY) => Ok(false),
+                _ => Err(error),
+            }
+        }
+    }
+}
+
+fn module_names(text: &str) -> Result<Vec<String>> {
+    let mut names = Vec::new();
+    for name in text.split('\n').filter(|name| !name.is_empty()) {
+        module_name(name)?;
+        if names.iter().any(|previous| previous == name) {
+            bail!("KPM loader returned duplicate module names");
+        }
+        names.push(name.to_owned());
+    }
+    Ok(names)
+}
+
+fn info(name: &str) -> Result<String> {
+    let name_c = module_name(name)?;
+    let mut buffer = vec![0u8; INFO_CAPACITY];
+    invoke(uapi::SUKISU_KPM_INFO, name_c.as_ptr() as u64, buffer.as_mut_ptr() as u64)?;
+    text_buffer(&buffer)
+}
+
+fn info_fields(raw: &str) -> BTreeMap<String, String> {
+    raw.lines().filter_map(|line| {
+        let (key, value) = line.split_once('=')?;
+        let key = key.trim();
+        if key.is_empty() || key.starts_with('#') {
+            None
+        } else {
+            Some((key.to_owned(), value.trim().to_owned()))
+        }
+    }).collect()
+}
+
+fn load(path: &Path, args: Option<&str>) -> Result<()> {
+    let path_c = bounded_cstring(path.as_os_str().as_encoded_bytes(), PATH_CAPACITY, "path", false)?;
+    let args_c = bounded_cstring(args.unwrap_or_default().as_bytes(), ARG_CAPACITY, "arguments", true)?;
+    let metadata = std::fs::symlink_metadata(path).context("Cannot inspect the selected KPM module")?;
+    if !metadata.file_type().is_file() {
+        bail!("KPM load requires a regular module file");
+    }
+    invoke(uapi::SUKISU_KPM_LOAD, path_c.as_ptr() as u64, args_c.as_ptr() as u64)?;
+    Ok(())
+}
+
+fn unload(name: &str) -> Result<()> {
+    let name_c = module_name(name)?;
+    invoke(uapi::SUKISU_KPM_UNLOAD, name_c.as_ptr() as u64, 0)?;
+    Ok(())
+}
+
+fn control(name: &str, args: &str) -> Result<i32> {
+    let name_c = module_name(name)?;
+    let args_c = bounded_cstring(args.as_bytes(), ARG_CAPACITY, "control arguments", false)?;
+    invoke(uapi::SUKISU_KPM_CONTROL, name_c.as_ptr() as u64, args_c.as_ptr() as u64)
+}
+
+pub fn run(arguments: KpmArgs) -> Result<()> {
+    match arguments.command {
+        KpmCommand::Supported { json } => {
+            let supported = supported_with(version)?;
+            if json {
+                println!("{}", serde_json::json!({"supported": supported, "abi": BRIDGE_ABI}));
+            } else {
+                println!("{supported}");
+            }
+        }
+        KpmCommand::Version { json } => {
+            let version = version()?;
+            if json {
+                println!("{}", serde_json::json!({"version": version, "abi": BRIDGE_ABI}));
+            } else {
+                println!("{version}");
+            }
+        }
+        KpmCommand::Num { json } => {
+            let count = invoke(uapi::SUKISU_KPM_NUM, 0, 0)?;
+            if json {
+                println!("{}", serde_json::json!({"count": count}));
+            } else {
+                println!("{count}");
+            }
+        }
+        KpmCommand::List { json } => {
+            let names = module_names(&read_text(uapi::SUKISU_KPM_LIST, TEXT_CAPACITY)?)?;
+            if json {
+                println!("{}", serde_json::to_string(&names)?);
+            } else {
+                for name in names { println!("{name}"); }
+            }
+        }
+        KpmCommand::Info { name, json } => {
+            let raw = info(&name)?;
+            if json {
+                println!("{}", serde_json::json!({"name": name, "fields": info_fields(&raw), "raw": raw}));
+            } else {
+                print!("{raw}");
+            }
+        }
+        KpmCommand::Load { path, args } => load(&path, args.as_deref())?,
+        KpmCommand::Unload { name } => unload(&name)?,
+        KpmCommand::Control { name, args } => println!("{}", control(&name, &args)?),
+    }
+    Ok(())
+}
